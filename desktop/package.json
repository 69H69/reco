{
  "name": "reco-desktop",
  "productName": "Reco",
  "version": "1.0.0",
  "description": "Reco pour ordinateur : enregistre ton écran et ta caméra, partage la vidéo avec un lien.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node copy-ui.mjs && electron-builder --win",
    "dist:mac": "node copy-ui.mjs && electron-builder --mac",
    "copy-ui": "node copy-ui.mjs"
  },
  "build": {
    "appId": "app.reco.desktop",
    "productName": "Reco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-preload.js",
      "local.js",
      "drive.js",
      "*.html",
      "default-server.json",
      "google-client.json",
      "assets/**",
      "ui/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Reco-Setup-${version}.exe",
      "shortcutName": "Reco"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Reco-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Reco utilise ta caméra pendant l'enregistrement.",
        "NSMicrophoneUsageDescription": "Reco utilise ton micro pendant l'enregistrement.",
        "NSScreenCaptureUsageDescription": "Reco enregistre l'écran ou la fenêtre que tu choisis."
      }
    },
    "dmg": {
      "title": "Reco"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  }
}