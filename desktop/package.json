{
  "name": "reco-desktop",
  "productName": "Reco",
  "version": "1.0.0",
  "description": "Reco pour ordinateur : enregistre ton écran et ta caméra, partage la vidéo avec un lien.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "app.reco.desktop",
    "productName": "Reco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "default-server.json",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Reco-Setup-${version}.exe",
      "shortcutName": "Reco"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.video"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  }
}
